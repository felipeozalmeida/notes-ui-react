{
  "name": "notes-ui-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23.0.0",
    "npm": ">=10.9.2 <11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "run-p --aggregate-output type-check lint format build-only",
    "type-check": "tsc --build",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix strict",
    "lint": "run-p --aggregate-output lint:js lint:css",
    "lint:fix": "run-p --aggregate-output lint:js:fix lint:css:fix",
    "format": "prettier --check src/",
    "format:fix": "prettier --write src/",
    "build-only": "vite build",
    "preview": "vite preview",
    "commit": "commit"
  },
  "dependencies": {
    "@tabler/icons-react": "3.36.0",
    "@tailwindcss/vite": "4.1.14",
    "clsx": "2.1.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-hot-toast": "2.6.0",
    "tailwindcss": "4.1.14",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@commitlint/prompt-cli": "19.8.1",
    "@dreamsicle.io/stylelint-config-tailwindcss": "1.2.2",
    "@eslint/js": "9.36.0",
    "@types/node": "24.6.0",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "eslint": "9.36.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.22",
    "globals": "16.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.1.5",
    "npm-run-all2": "8.0.4",
    "prettier": "3.6.2",
    "stylelint": "17.14.0",
    "stylelint-config-recess-order": "7.7.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.45.0",
    "vite": "7.3.6"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.css": [
      "stylelint --fix strict",
      "prettier --write"
    ],
    "!(src/**/*.{ts,tsx,css})": "prettier --write --ignore-unknown"
  }
}
